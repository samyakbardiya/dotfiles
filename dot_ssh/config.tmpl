    LocalForward 5432 localhost:5432    # PostgreSQL
    LocalForward 5601 localhost:5601    # OpenSearch
    LocalForward 5602 localhost:5602    # OpenSearch
    LocalForward 8097 localhost:8097    # React Devtools
    LocalForward 27017 localhost:27017  # Mongo DB

    # Project: Wave Signage / AppControl
