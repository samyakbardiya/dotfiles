function mkcd() {
	[[ -n ${1} ]] && mkdir -p ${1} && builtin cd ${1}
}

# case conversion

function camelcase() {
	perl -pe 's#(_)(.)#\u$2#g'
}

function snakecase() {
	perl -pe 's#([A-Z])#_\L$1#g' | perl -pe 's#^_##'
}

