{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$docs": "https://code.claude.com/docs/en/settings",
  "model": "claude-sonnet-4-6",
  "effortLevel": "medium",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
{{ if eq .chezmoi.os "darwin" }}
            "command": "bash '/Users/samyakbardiya/.claude/hooks/herdr-agent-state.sh' session",
{{ else if eq .chezmoi.os "linux" }}
            "command": "bash '/home/samyak_bardiya/.claude/hooks/herdr-agent-state.sh' session",
{{ end }}
            "timeout": 10
          }
        ]
      }
    ]
  }
}
